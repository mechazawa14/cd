
%{
#include "y.tab.h"
%}

%%
[a-zA-Z][a-zA-Z0-9]* { yylval.ch = yytext[0]; return ID; }
[ \t]                ;
\n                   { return '\n'; }
.                    { return yytext[0]; }
%%

int yywrap() {
    return 1;
}

%{
#include <stdio.h>
#include <stdlib.h>

struct node {
    char data ;
    struct node *left , * right ; 
};

struct node *newnode(char c , struct node* l , struct node * r){
    struct node * n = malloc(sizeof(struct node));
    n -> data  = c;
    n-> left  = l ;
    n-> right  = r ;
    return n;
}

void printTree(struct node * n, int level ){
    if(n == NULL){
        return;
    }
    for (int i = 0 ; i < level; i++) printf(" ");
    printf("%c\n", n->data);
    printTree(n->left , level+1);
    printTree(n->right , level+1);
}
int yylex();
void yyerror(char *);
struct node * root ;

%}

%union {
    char ch ;
    struct node* ptr ;
}

%token <ch> ID
%type <ptr> E

%left '+'
%left '*'

%% 
S : E '\n' {root =  $1; printTree(root, 0);};
E : E '+' E    {$$ = newnode('+', $1, $3);}
  | E '*' E    {$$ = newnode('*', $1, $3);}
  | '(' E ')'   {$$ = $2;}
  | ID          {$$ = newnode($1, NULL, NULL);}
  ;
%%

void yyerror(char *){
    printf("invalid input\n");
}

int main(){
    printf("enter the tree input:\n");
    yyparse();
    return 0;

}
