%{
  #include "y.tab.h"
  #include <stdio.h>
  #include <stdlib.h>
%}

%%
[0-9]*   {yylval  = atoi(yytext); return NUM;}
[\n]                   {return '\n';}
[\t]                    ;
.                       {return yytext[0];}
%%

int yywrap(){
    return 1;
}

%{
#include <stdio.h>
int yylex();
void yyerror(char *);
%}

%token NUM
%left '+' '-'
%left '*' '/'

%%
S : E '\n' {printf("%d\n", $1);};
E : E '+' E {$$ = $1 + $3;}
  | E '-' E {$$ = $1 - $3;}
  | E '*' E {$$ = $1 * $3;}
  | E '/' E {$$ = $1 / $3;}
  | '(' E ')' {$$ = $2;}
  |NUM {$$ = $1;}
  ;
%%

void yyerror(char *){
    printf("invalid input\n");
}

int main(){
    printf("enter the expression\n");
    yyparse();
    return 0;
}
